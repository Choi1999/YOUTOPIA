[Unit]
Description=Youtopia application (prebuilt release)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=youtopia-app
Group=youtopia-app
WorkingDirectory=/opt/youtopia-app/current
EnvironmentFile=/etc/youtopia-app/app.env
Environment=SERVER_ADDRESS=127.0.0.1 SERVER_PORT=8080 SERVER_FORWARD_HEADERS_STRATEGY=framework
ExecStartPre=/usr/bin/test -f /etc/youtopia-app/RELEASE_APPROVED
ExecStart=/usr/bin/java -Xms256m -Xmx2g -XX:MaxDirectMemorySize=128m -XX:+ExitOnOutOfMemoryError -jar /opt/youtopia-app/current/app.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
SuccessExitStatus=143
CPUQuota=150%
MemoryHigh=2560M
MemoryMax=3G
MemorySwapMax=0
TasksMax=256
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LogNamespace=youtopia
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
