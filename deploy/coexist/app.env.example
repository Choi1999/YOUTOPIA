# Template only; all feature flags remain closed until acceptance. Never source as shell.
# JDBC sslmode=disable only for host loopback; remote control requires verified TLS.
YOUTOPIA_ENVIRONMENT=PRODUCTION
YOUTOPIA_ACCOUNTS_DELETION_ENABLED=false
YOUTOPIA_ACCOUNTS_RECONCILIATION_ENABLED=false
YOUTOPIA_ACCOUNTS_RECONCILIATION_DELAY_MS=60000
YOUTOPIA_DATA_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_DATA_DB_USER=ytp_app_data_ro
YOUTOPIA_DATA_DB_PASSWORD=
YOUTOPIA_SESSION_REDIS_HOST=127.0.0.1
YOUTOPIA_SESSION_REDIS_PORT=6379
YOUTOPIA_SESSION_REDIS_USERNAME=youtopia
YOUTOPIA_SESSION_REDIS_PASSWORD=
YOUTOPIA_SESSION_REDIS_TLS=false
YOUTOPIA_ACCOUNTS_ENABLED=false
YOUTOPIA_ACCOUNT_HMAC_KEY=
YOUTOPIA_PASSWORD_BLOCKLIST=/etc/youtopia-app/password-blocklist.sha256
YOUTOPIA_MEMBER_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_MEMBER_DB_USER=ytp_app_member
YOUTOPIA_MEMBER_DB_PASSWORD=
YOUTOPIA_ADMIN_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_ADMIN_DB_USER=ytp_app_admin_auth
YOUTOPIA_ADMIN_DB_PASSWORD=
YOUTOPIA_AUDIT_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_AUDIT_DB_USER=ytp_app_audit
YOUTOPIA_AUDIT_DB_PASSWORD=
YOUTOPIA_DIRECTORY_ENABLED=false
YOUTOPIA_DIRECTORY_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_DIRECTORY_DB_USER=ytp_app_directory
YOUTOPIA_DIRECTORY_DB_PASSWORD=
YOUTOPIA_EVENTS_ENABLED=false
YOUTOPIA_EVENT_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_EVENT_DB_USER=ytp_app_event
YOUTOPIA_EVENT_DB_PASSWORD=
YOUTOPIA_ACTIVE_SESSION_WINDOW_SECONDS=300
YOUTOPIA_REPORTING_ENABLED=false
YOUTOPIA_REPORT_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/youtopia?sslmode=disable
YOUTOPIA_REPORT_DB_USER=ytp_app_report
YOUTOPIA_REPORT_DB_PASSWORD=
YOUTOPIA_PRIVACY_ENABLED=false
YOUTOPIA_RETENTION_APPROVAL_REF=
YOUTOPIA_RETENTION_PLAN=
YOUTOPIA_PRIVACY_JDBC_URL=
YOUTOPIA_PRIVACY_DB_USER=
YOUTOPIA_PRIVACY_DB_PASSWORD=
YOUTOPIA_CONTROL_ENABLED=false
YOUTOPIA_CONTROL_SERVICE_KEY=youtopia
YOUTOPIA_CONTROL_HMAC_KEY=
YOUTOPIA_CONTROL_JDBC_URL=
YOUTOPIA_CONTROL_DB_USER=ytp_control_app
YOUTOPIA_CONTROL_DB_PASSWORD=
YOUTOPIA_GAMES_ENABLED=false
YOUTOPIA_QUERY_ASSOCIATIONS_ENABLED=false
